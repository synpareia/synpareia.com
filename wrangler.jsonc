{
  // Cloudflare Workers config for synpareia.com.
  //
  // Required by wrangler 4.x — earlier wrangler versions auto-detected
  // ./dist as the asset directory, but wrangler 4 needs this explicitly
  // declared (deploy fails with "Missing entry-point to Worker script
  // or to assets directory" otherwise; 2026-05-13 incident).
  //
  // 2026-06-10 (launch hit-list 2.6a): added the worker entry for
  // markdown content negotiation. The old Pages Function
  // (functions/_middleware.ts) never executed on this static-asset
  // deploy — the sidecars were built but unserved. `run_worker_first`
  // is load-bearing: without it, requests matching an asset bypass the
  // worker and negotiation silently dies again.
  "name": "synpareia",
  "compatibility_date": "2026-05-09",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
